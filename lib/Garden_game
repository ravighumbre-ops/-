
import 'dart:math' as math;
import 'package:flutter/material.dart';

class GardenGame extends StatefulWidget {
  const GardenGame({super.key});

  @override
  State<GardenGame> createState() => _GardenGameState();
}

class _GardenGameState extends State<GardenGame> {
  int stage = 0;
  int water = 0;
  int stars = 0;

  final List<String> lessons = [
    'चला, माती तयार करूया!',
    'छान! आता बी पेरा.',
    'रोपाला दोन वेळा पाणी घाला.',
    'रोपाला सूर्यप्रकाश द्या.',
    'शाब्बास! तुझ्या बागेत फूल उमलले!',
  ];

  final List<String> tips = [
    '🌱 झाडांना वाढण्यासाठी माती लागते.',
    '🌰 बियापासून नवीन रोप उगवते.',
    '💧 पाणी रोपाला वाढण्यास मदत करते.',
    '☀️ सूर्यप्रकाश वनस्पतींसाठी महत्त्वाचा आहे.',
    '🌻 झाडांची काळजी घ्या!',
  ];

  String get plantEmoji {
    if (stage == 0) return '🟤';
    if (stage == 1) return '🕳️';
    if (stage == 2) return water == 0 ? '🌰' : '🌱';
    if (stage == 3) return '🌿';
    return '🌻';
  }

  void doAction() {
    if (stage >= 4) return;

    setState(() {
      if (stage == 0) {
        stage = 1;
      } else if (stage == 1) {
        stage = 2;
        stars++;
      } else if (stage == 2) {
        water++;
        if (water >= 2) {
          stage = 3;
          stars++;
        }
      } else if (stage == 3) {
        stage = 4;
        stars += 3;
      }
    });
  }

  void restart() {
    setState(() {
      stage = 0;
      water = 0;
      stars = 0;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('🌱 जादूची बाग'),
        backgroundColor: const Color(0xFFB7F0A1),
        actions: [
          Padding(
            padding: const EdgeInsets.only(right: 14),
            child: Center(
              child: Text(
                '⭐ $stars',
                style: const TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),
        ],
      ),
      body: Container(
        decoration: const BoxDecoration(
          gradient: LinearGradient(
            colors: [
              Color(0xFF8ADFFF),
              Color(0xFFE5F9D6),
              Color(0xFFFFEFB8),
            ],
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
          ),
        ),
        child: SafeArea(
          child: SingleChildScrollView(
            padding: const EdgeInsets.all(16),
            child: Column(
              children: [
                Text(
                  lessons[stage],
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontSize: 24,
                    fontWeight: FontWeight.bold,
                    color: Color(0xFF48217F),
                  ),
                ),
                const SizedBox(height: 8),
                Text(
                  tips[stage],
                  textAlign: TextAlign.center,
                  style: const TextStyle(fontSize: 17),
                ),
                const SizedBox(height: 20),

                // बागेचे दृश्य
                Container(
                  height: 300,
                  width: double.infinity,
                  clipBehavior: Clip.antiAlias,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(28),
                    gradient: const LinearGradient(
                      colors: [
                        Color(0xFF6BCFFF),
                        Color(0xFFE1F8FF),
                      ],
                      begin: Alignment.topCenter,
                      end: Alignment.bottomCenter,
                    ),
                  ),
                  child: Stack(
                    alignment: Alignment.center,
                    children: [
                      const Positioned(
                        top: 15,
                        right: 18,
                        child: Text(
                          '☀️',
                          style: TextStyle(fontSize: 50),
                        ),
                      ),
                      const Positioned(
                        top: 28,
                        left: 20,
                        child: Text(
                          '☁️',
                          style: TextStyle(fontSize: 38),
                        ),
                      ),
                      const Positioned(
                        top: 72,
                        right: 38,
                        child: Text(
                          '🦋',
                          style: TextStyle(fontSize: 30),
                        ),
                      ),
                      Positioned(
                        left: 0,
                        right: 0,
                        bottom: 0,
                        height: 100,
                        child: Container(
                          decoration: const BoxDecoration(
                            color: Color(0xFF815137),
                            borderRadius: BorderRadius.vertical(
                              top: Radius.circular(28),
                            ),
                          ),
                          child: const Center(
                            child: Text(
                              '🌼  🌱  🌼  🌱  🌼',
                              style: TextStyle(fontSize: 26),
                            ),
                          ),
                        ),
                      ),
                      Positioned(
                        bottom: 78,
                        child: AnimatedSwitcher(
                          duration: const Duration(milliseconds: 650),
                          transitionBuilder: (child, animation) {
                            return ScaleTransition(
                              scale: animation,
                              child: child,
                            );
                          },
                          child: Text(
                            plantEmoji,
                            key: ValueKey(plantEmoji),
                            style: const TextStyle(fontSize: 100),
                          ),
                        ),
                      ),
                      if (stage == 2)
                        Positioned(
                          top: 125,
                          left: 0,
                          right: 0,
                          child: Text(
                            water == 0 ? '💧' : '💧 💧',
                            textAlign: TextAlign.center,
                            style: const TextStyle(fontSize: 30),
                          ),
                        ),
                      if (stage == 4)
                        const Positioned(
                          top: 95,
                          left: 0,
                          right: 0,
                          child: Text(
                            '✨ ⭐ ✨',
                            textAlign: TextAlign.center,
                            style: TextStyle(fontSize: 30),
                          ),
                        ),
                    ],
                  ),
                ),

                const SizedBox(height: 20),

                // प्रगती
                Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: List.generate(5, (index) {
                    return Container(
                      margin: const EdgeInsets.symmetric(horizontal: 4),
                      width: 34,
                      height: 34,
                      decoration: BoxDecoration(
                        color: index <= stage
                            ? Colors.green
                            : Colors.white,
                        shape: BoxShape.circle,
                        border: Border.all(color: Colors.green),
                      ),
                      child: Center(
                        child: Text(
                          index < stage ? '✓' : '${index + 1}',
                          style: TextStyle(
                            color: index <= stage
                                ? Colors.white
                                : Colors.green,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    );
                  }),
                ),

                const SizedBox(height: 20),

                if (stage < 4)
                  SizedBox(
                    width: double.infinity,
                    height: 60,
                    child: ElevatedButton(
                      onPressed: doAction,
                      style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF39A950),
                        foregroundColor: Colors.white,
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(20),
                        ),
                      ),
                      child: Text(
                        [
                          '🪴 माती तयार करा',
                          '🌰 बी पेरा',
                          water == 0
                              ? '💧 पाणी घाला (१/२)'
                              : '💧 पुन्हा पाणी घाला (२/२)',
                          '☀️ सूर्यप्रकाश द्या',
                        ][stage],
                        style: const TextStyle(
                          fontSize: 21,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ),
                  ),

                if (stage == 4)
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(18),
                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius: BorderRadius.circular(22),
                    ),
                    child: const Column(
                      children: [
                        Text(
                          '🎉 शाब्बास बाळा!',
                          style: TextStyle(
                            fontSize: 27,
                            fontWeight: FontWeight.bold,
                            color: Colors.deepPurple,
                          ),
                        ),
                        SizedBox(height: 10),
                        Text(
                          'तू रोप वाढवलेस! झाडे आपल्याला मदत करतात.',
                          textAlign: TextAlign.center,
                          style: TextStyle(fontSize: 18),
                        ),
                      ],
                    ),
                  ),

                const SizedBox(height: 14),

                OutlinedButton.icon(
                  onPressed: restart,
                  icon: const Icon(Icons.refresh),
                  label: const Text(
                    'पुन्हा खेळूया',
                    style: TextStyle(fontSize: 18),
                  ),
                ),

                const SizedBox(height: 12),
                const Text(
                  '🌍 झाडे लावा, पृथ्वी वाचवा!',
                  style: TextStyle(
                    fontSize: 19,
                    fontWeight: FontWeight.bold,
                    color: Color(0xFF236D39),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
